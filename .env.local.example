# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard Supabase → Authentication → URL Configuration :
#   Site URL : https://votre-domaine.fr
#   Redirect URLs : https://votre-domaine.fr/auth/confirm (et http://localhost:3000/auth/confirm en dev)
#                   https://votre-domaine.fr/auth/update-password (réinitialisation mot de passe)

# ─── Stripe (Phase B) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Abonnement Accès plateforme (300 €/mois) — Dashboard Stripe → Produit récurrent
STRIPE_PLATFORM_PRICE_ID=
# Coupon Stripe −20 % une fois (1er mois à 240 €) — optionnel mais recommandé
STRIPE_PLATFORM_INTRO_COUPON_ID=
# Pack Territoire (legacy, achat unique)
STRIPE_TERRITOIRE_PACK_PRICE_ID=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Clé API : https://resend.com/api-keys
# Domaine vérifié sur Resend : solarindex.fr (SPF/DKIM)
# Inscription : l'email de confirmation passe par Resend (route /api/auth/signup),
# pas le SMTP par défaut Supabase. Optionnel : SMTP Resend dans Supabase Auth
# (smtp.resend.com, user « resend », mot de passe = clé API).
RESEND_API_KEY=
RESEND_FROM=SolarIndex <contact@solarindex.fr>
# Alertes modération RFP (+ livraison leads si besoin)
ADMIN_EMAIL=contact@solarindex.fr

# ─── Tokens internes ─────────────────────────────────────────────────────────
ADMIN_SECRET_TOKEN=
PIPELINE_INGEST_TOKEN=
# Optionnel : probe crédits Pappers depuis /admin (sinon lu par le pipeline Python)
# Utilisé aussi pour téléphones dirigeants / entreprise quand l'open data n'en fournit pas.
PAPPERS_API_TOKEN=

# ─── Analytics (Plausible — script dashboard, sans proxy) ────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=solarindex.fr
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/pa-ovrHkV6d0xXFSasjvDwiU.js
# PLAUSIBLE_DEV=true  # activer le tracking en dev local

# ─── Divers ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000
